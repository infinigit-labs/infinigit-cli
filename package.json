{
  "name": "infinigit-cli",
  "version": "0.1.5",
  "description": "Browser-linked Internet Identity CLI for InfiniGit",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infinigit-labs/infinigit-cli.git"
